# ========================================================
# DC-Intelli AIOps Platform Environment Configuration
# ========================================================

# Server Runtime Configuration
PORT=3000
NODE_ENV=development

# MongoDB Connection String
# For Local MongoDB: mongodb://127.0.0.1:27017/data_center_aiops
# For MongoDB Atlas: mongodb+srv://<db_user>:<db_pass>@cluster0.mongodb.net/data_center_aiops?retryWrites=true&w=majority
MONGODB_URI="mongodb://127.0.0.1:27017/data_center_aiops"

# JWT Authentication Secrets
JWT_SECRET="replace_with_a_secure_jwt_secret_key_minimum_32_characters"
JWT_EXPIRES_IN="24h"

# Gemini AIOps Intelligence API Key
# Optional: The platform can run with fallback telemetry heuristics if omitted,
# but live neural RCA and AI maintenance work orders require this key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Application & Frontend URLs
APP_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
